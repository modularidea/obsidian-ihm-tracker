{
	"name": "ihm-tracker",
	"version": "0.10.4",
	"description": "IHateMoney client for Obsidian: view and edit shared-expense bills, auto-categorize them, statistics, PDF/Excel export.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"license": "0BSD",
	"dependencies": {
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.8",
		"xlsx": "^0.18.5"
	},
	"devDependencies": {
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"vitest": "^3.0.0"
	}
}
